<?php
declare(strict_types=1);

/**
 * Favorite Categories — settings.
 *
 * Shape: one list of categories, favorites first, one star button per row. The
 * view control is the same three-state cycle as the sidebar button. Everything
 * diagnostic is collapsed into <details>.
 *
 * Deliberately NOT: a wall of prose, four rival sections, or timestamps in the
 * default view. If a line here is not a control or a count, it lives in Details.
 *
 * @var FavoriteCategoriesExtension $this
 */

$store = $this->store();
$storeOk = $store->assertSchema();
$favs = $store->favCategories();
$favIds = [];
foreach ($favs as $f) {
	$favIds[$f['cat_id']] = true;
}
$problems = $storeOk ? $store->invariantProblems() : [];
$csrf = FreshRSS_Auth::csrfToken();
$url = _url('extension', 'configure', 'e', urlencode($this->getName()));

// the same three-state control as the sidebar button, so the page and the
// button can never disagree about what "next click" means
$view = $store->view();
$nextView = $store->nextView();
$viewLabels = [
	'all' => ['Show favorites only', 'Filter down to just your favorite categories'],
	'only' => ['Hide favorites', 'Filter your favorites out instead'],
	'without' => ['Show all', 'Stop filtering and show everything'],
];
$viewLabel = ['all' => 'everything', 'only' => 'favorites only', 'without' => 'favorites filtered out'][$view] ?? 'everything';
$nextViewLabel = $viewLabels[$nextView][0] ?? 'Show favorites only';
$nextViewTitle = $viewLabels[$nextView][1] ?? '';

$cats = $this->categories();
$favRows = [];
$otherRows = [];
foreach ($cats as $c) {
	if (isset($favIds[$c['id']])) {
		$favRows[] = $c;
	} else {
		$otherRows[] = $c;
	}
}

/** One row: star, name, feed count, [Favorite|Unfavorite] */
$row = static function (array $c, bool $isFav) use ($url, $csrf): void {
	?>
	<div class="fc-row<?= $isFav ? ' fc-is-fav' : '' ?>">
		<span class="fc-star" aria-hidden="true"><?= $isFav ? '&#9733;' : '&#9734;' ?></span>
		<span class="fc-name" title="<?= htmlspecialchars($c['name'], ENT_QUOTES) ?>"><?= htmlspecialchars($c['name'], ENT_QUOTES) ?></span>
		<span class="fc-feeds"><?= $c['feeds'] ?> <?= $c['feeds'] === 1 ? 'feed' : 'feeds' ?></span>
		<form method="post" action="<?= $url ?>">
			<input type="hidden" name="_csrf" value="<?= $csrf ?>" />
			<input type="hidden" name="act" value="<?= $isFav ? 'unfav' : 'fav' ?>" />
			<input type="hidden" name="cat" value="<?= $c['id'] ?>" />
			<button class="fc-act" type="submit" title="<?= $isFav ? 'Remove from favorites (the category itself is untouched)' : 'Add this category to favorites' ?>"><?= $isFav ? 'Unfavorite' : 'Favorite' ?></button>
		</form>
	</div>
	<?php
};
?>
<div id="favorite-categories-config" class="favorite-categories">

	<?php if (!$storeOk) { ?>
		<p class="alert alert-error">
			The extension cannot reach its own settings file, so favoriting is unavailable:
			<?= htmlspecialchars($store->error(), ENT_QUOTES) ?>
		</p>
	<?php } ?>
	<?php if ($store->notice() !== '') { ?>
		<p class="alert alert-warn"><?= htmlspecialchars($store->notice(), ENT_QUOTES) ?></p>
	<?php } ?>
	<?php foreach ($problems as $p) { ?>
		<p class="alert alert-error"><?= htmlspecialchars($p, ENT_QUOTES) ?></p>
	<?php } ?>

	<?php if ($favRows === []) { ?>
		<div class="fc-empty">
			<strong>No favorites yet.</strong><br />
			Press <em>Favorite</em> next to a category below, or the star on a category box under
			<em>Subscription management</em>. Favoriting never changes the category or its feeds — it
			only marks it for the filter.
		</div>
	<?php } else { ?>
		<div class="fc-group-label">Favorites &middot; <?= count($favRows) ?></div>
		<div class="fc-list">
			<?php foreach ($favRows as $c) { $row($c, true); } ?>
		</div>
	<?php } ?>

	<div class="fc-group-label">Everything else &middot; <?= count($otherRows) ?></div>
	<div class="fc-list">
		<?php foreach ($otherRows as $c) { $row($c, false); } ?>
		<?php if ($otherRows === []) { ?>
			<div class="fc-empty">Every category is a favorite.</div>
		<?php } ?>
	</div>

	<div class="fc-group-label">Filter</div>
	<form method="post" action="<?= $url ?>">
		<input type="hidden" name="_csrf" value="<?= $csrf ?>" />
		<input type="hidden" name="act" value="view" />
		<input type="hidden" name="to" value="<?= $nextView ?>" />
		<div class="fc-card">
			<p class="fc-hint">
				Currently: <strong><?= htmlspecialchars($viewLabel, ENT_QUOTES) ?></strong>.
				The same control as the star above the sidebar.
			</p>
			<button class="btn btn-important" type="submit" title="<?= htmlspecialchars($nextViewTitle, ENT_QUOTES) ?>">
				<?= htmlspecialchars($nextViewLabel, ENT_QUOTES) ?>
			</button>
		</div>
	</form>

	<div class="fc-group-label">Sidebar</div>
	<?php
	$rowLabel = $store->rowLabel();
	$modeRow = $store->rowMode();
	$favN = count($favRows);
	?>
	<div class="fc-card">
		<p class="fc-hint">
			How the favorites row in the sidebar tree labels itself. Display only — nothing about
			which categories are favorites, or what the star button does.
		</p>

		<?php // the saved state, drawn as the real row: this is the confirmation that a change landed ?>
		<div class="fc-preview">
			<span class="fc-preview-cap">Now reads</span>
			<span class="fc-preview-row">
				<span class="fc-caret" aria-hidden="true">&#9662;</span>
				<?php if ($modeRow === 'caret') { ?>
					<span class="fc-preview-none">just the caret &nbsp;&mdash; nothing else</span>
				<?php } elseif ($modeRow === 'both' && $rowLabel !== '') { ?>
					<span class="fc-row-label"><?= htmlspecialchars($rowLabel, ENT_QUOTES) ?></span>
					<span class="fc-row-num"><?= $favN ?></span>
				<?php } else { ?>
					<span class="fc-row-num"><?= $favN ?></span>
				<?php } ?>
			</span>
		</div>

		<?php
		// One form, one Save button, three display states. A checkbox cannot
		// express "label but no number", which is the state that actually
		// obscures the row. A radio group says exactly which of the three it is.
		$modes = [
			'caret' => ['Nothing but the caret', 'the row draws no text at all'],
			'number' => ['The number only', 'how many categories are favorites'],
			'both' => ['Label and number', 'the label, then the number'],
		];
		?>
		<form method="post" action="<?= $url ?>" id="favorite-categories-display-form">
			<input type="hidden" name="_csrf" value="<?= $csrf ?>" />
			<input type="hidden" name="act" value="display" />

			<div class="fc-modes" role="radiogroup" aria-label="What the sidebar row shows">
				<?php foreach ($modes as $val => [$title, $sub]) { ?>
					<label class="fc-mode-radio">
						<input type="radio" name="rowmode" value="<?= $val ?>"
							<?= $modeRow === $val ? 'checked' : '' ?> data-fc-rowmode />
						<span>
							<strong><?= $title ?></strong>
							<em><?= $sub ?></em>
						</span>
					</label>
				<?php } ?>
			</div>

			<label class="fc-label-field">
				<span>Label text (used by "Label and number")</span>
				<input type="text" name="label" class="fc-label-input"
					value="<?= htmlspecialchars($rowLabel, ENT_QUOTES) ?>"
					placeholder="leave empty for the number on its own"
					maxlength="40" autocomplete="off" data-fc-label />
			</label>

			<div class="fc-save-bar">
				<button class="btn btn-important" type="submit">Save</button>
				<span class="fc-dirty" data-fc-dirty aria-live="polite"></span>
			</div>
		</form>

		<div class="fc-live" aria-live="polite">
			<span class="fc-live-cap">After saving</span>
			<span class="fc-preview-row" data-fc-live>
				<span class="fc-caret" aria-hidden="true">&#9662;</span>
				<?php if ($modeRow === 'both' && $rowLabel !== '') { ?>
					<span class="fc-row-label"><?= htmlspecialchars($rowLabel, ENT_QUOTES) ?></span>
					<span class="fc-row-num"><?= $favN ?></span>
				<?php } elseif ($modeRow !== 'caret') { ?>
					<span class="fc-row-num"><?= $favN ?></span>
				<?php } ?>
			</span>
			<span class="fc-live-msg" data-fc-live-msg>unchanged</span>
		</div>
	</div>

	<details class="fc-details">
		<summary>Details</summary>
		<dl>
			<dt>Favorites</dt><dd><?= count($favRows) ?> of <?= count($cats) ?> categories</dd>
			<dt>View</dt><dd><?= htmlspecialchars($viewLabel, ENT_QUOTES) ?></dd>
			<dt>Written to feeds</dt><dd>Never. Favoriting is a browser-side filter, so nothing is
				written to a feed and nothing needs restoring when you switch this off.</dd>
			<dt>On since</dt><dd><?= htmlspecialchars($store->getMeta('first_enabled_at', '—'), ENT_QUOTES) ?></dd>
			<dt>Last disabled</dt><dd><?= htmlspecialchars($store->getMeta('last_disabled_at', 'never'), ENT_QUOTES) ?></dd>
			<dt>Storage</dt><dd><code><?= htmlspecialchars($store->path(), ENT_QUOTES) ?></code></dd>
			<dt>Works with</dt><dd>Any extension: this one only ever reads the page's own markup, and
				never takes over a row another extension has hidden.</dd>
			<dt>Switching off</dt><dd>Nothing to undo — no feed was touched. Favorites and display
				options are kept and come back when you re-enable it.</dd>
		</dl>
	</details>
</div>
