<?php
declare(strict_types=1);

/**
 * Pinned Categories — settings.
 *
 * Shape: one list of categories, pinned first, one pin button per row. The
 * view control is the same three-state cycle as the sidebar button. Everything
 * diagnostic is collapsed into <details>.
 *
 * Deliberately NOT: a wall of prose, four rival sections, or timestamps in the
 * default view. If a line here is not a control or a count, it lives in Details.
 *
 * @var FavoriteCategoriesExtension $this
 */

$store = $this->store();
$storeOk = $store->assertSchema();
$favs = $store->favCategories();
$favIds = [];
foreach ($favs as $f) {
	$favIds[$f['cat_id']] = true;
}
$problems = $storeOk ? $store->invariantProblems() : [];
$csrf = FreshRSS_Auth::csrfToken();
$url = _url('extension', 'configure', 'e', urlencode($this->getName()));

// the same three-state control as the sidebar button, so the page and the
// button can never disagree about what "next click" means
$view = $store->view();
$nextView = $store->nextView();
// Labels and titles name the CURRENT state, matching the sidebar pin.
// One noun, the same one favorite.js builds: pinned.
$fcNoun = 'pinned';
$fcNounCap = 'Pinned';
$fcNounPl = 'pinned';
$viewLabels = [
	'all' => ['Mixed', 'Everything is showing — ' . $fcNounPl . ' are not filtering anything'],
	'only' => ['Just ' . $fcNounCap, 'Only your ' . $fcNoun . ' categories are showing'],
	'without' => ['Hide ' . $fcNounCap, $fcNounCap . ' are filtered out — everything else is showing'],
];
$viewLabel = ['all' => 'everything', 'only' => $fcNounPl . ' only', 'without' => $fcNounPl . ' hidden'][$view] ?? 'everything';
$nextViewLabel = $viewLabels[$view][0] ?? 'All';
$nextViewTitle = $viewLabels[$view][1] ?? '';

$cats = $this->categories();
$favRows = [];
$otherRows = [];
foreach ($cats as $c) {
	if (isset($favIds[$c['id']])) {
		$favRows[] = $c;
	} else {
		$otherRows[] = $c;
	}
}

/** One row: pin, name, feed count, [Pin|Unpin] */
$row = static function (array $c, bool $isFav) use ($url, $csrf): void {
	?>
	<div class="fc-row<?= $isFav ? ' fc-is-fav' : '' ?>">
		<span class="fc-star" aria-hidden="true"><svg viewBox="0 0 24 24" width="1em" height="1em" style="vertical-align:-.12em" fill="<?= $isFav ? 'currentColor' : 'none' ?>" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" role="presentation"><path d="M9 3h6l-.6 4.2 3.1 3.1v2.2h-4.9V20l-.6 1.2L11.4 20v-7.5H6.5v-2.2l3.1-3.1z"/></svg></span>
		<span class="fc-name" title="<?= htmlspecialchars($c['name'], ENT_QUOTES) ?>"><?= htmlspecialchars($c['name'], ENT_QUOTES) ?></span>
		<span class="fc-feeds"><?= $c['feeds'] ?> <?= $c['feeds'] === 1 ? 'feed' : 'feeds' ?></span>
		<form method="post" action="<?= $url ?>">
			<input type="hidden" name="_csrf" value="<?= $csrf ?>" />
			<input type="hidden" name="act" value="<?= $isFav ? 'unfav' : 'fav' ?>" />
			<input type="hidden" name="cat" value="<?= $c['id'] ?>" />
			<button class="fc-act" type="submit" title="<?= $isFav ? 'Unpin (the category itself is untouched)' : 'Pin this category' ?>"><?= $isFav ? 'Unpin' : 'Pin' ?></button>
		</form>
	</div>
	<?php
};
?>
<div id="favorite-categories-config" class="favorite-categories">

	<?php if (!$storeOk) { ?>
		<p class="alert alert-error">
			The extension cannot reach its own settings file, so pinning is unavailable:
			<?= htmlspecialchars($store->error(), ENT_QUOTES) ?>
		</p>
	<?php } ?>
	<?php if ($store->notice() !== '') { ?>
		<p class="alert alert-warn"><?= htmlspecialchars($store->notice(), ENT_QUOTES) ?></p>
	<?php } ?>
	<?php foreach ($problems as $p) { ?>
		<p class="alert alert-error"><?= htmlspecialchars($p, ENT_QUOTES) ?></p>
	<?php } ?>

	<?php if ($favRows === []) { ?>
		<div class="fc-empty">
			<strong>Nothing pinned yet.</strong><br />
			Press <em>Pin</em> next to a category below, or the pin on a category box under
			<em>Subscription management</em>. Pinning never changes the category or its feeds — it
			only marks it for the filter.
		</div>
	<?php } else { ?>
		<div class="fc-group-label">Pinned &middot; <?= count($favRows) ?></div>
		<div class="fc-list">
			<?php foreach ($favRows as $c) { $row($c, true); } ?>
		</div>
	<?php } ?>

	<div class="fc-group-label">Everything else &middot; <?= count($otherRows) ?></div>
	<div class="fc-list">
		<?php foreach ($otherRows as $c) { $row($c, false); } ?>
		<?php if ($otherRows === []) { ?>
			<div class="fc-empty">Every category is pinned.</div>
		<?php } ?>
	</div>

	<?php
	// Say plainly where the right-click item comes from. It is not ours: this
	// extension only appends an item to the menu RightClickActions builds, so
	// without that extension there is no menu to append to. Better to say so on
	// this page than to let someone right-click, find nothing, and call it a bug.
	// Read the user's own enabled list rather than Minz_ExtensionManager: the
	// manager only answers after its init() has run, and that list is keyed by
	// the extension's *name* ("Right-Click Actions"), not its entrypoint — so
	// asking for the entrypoint silently answers "no" and the panel would claim
	// an installed extension is missing. The config array is always available.
	$rcaInstalled = false;
	try {
		$enabled = FreshRSS_Context::userConf()->extensions_enabled;
		if (is_array($enabled)) {
			foreach (['Right-Click Actions', 'RightClickActions'] as $rcaName) {
				if (!empty($enabled[$rcaName])) { $rcaInstalled = true; break; }
			}
		}
	} catch (Throwable $e) {
		// no user config in this render: say nothing rather than guess
		$rcaInstalled = false;
	}
	?>
	<div class="fc-group-label">Right-click menu</div>
	<div class="fc-card">
		<p class="fc-hint">
			<?php if ($rcaInstalled) { ?>
				<strong>RightClickActions is installed.</strong> Right-clicking a category in the
				sidebar shows <em>Pin</em> / <em>Unpin</em>.
			<?php } else { ?>
				<strong>Needs the RightClickActions extension.</strong> This extension adds an
				<em>Pin</em> / <em>Unpin</em> item to the sidebar's
				right-click menu — but that menu belongs to
				<a href="https://github.com/printfuck/xExtension-RightClickActions" target="_blank" rel="noopener">RightClickActions</a>,
				not to this extension. <strong>Without it installed FreshRSS has no right-click
				menu at all</strong>, so there is nothing to add the item to. Everything else — the
				<em>Pin</em> button on each row above, the pin under <em>Subscription
				management</em>, and the pin above the sidebar — works either way.
			<?php } ?>
		</p>
	</div>

	<div class="fc-group-label">Filter</div>
	<form method="post" action="<?= $url ?>">
		<input type="hidden" name="_csrf" value="<?= $csrf ?>" />
		<input type="hidden" name="act" value="view" />
		<input type="hidden" name="to" value="<?= $nextView ?>" />
		<div class="fc-card">
			<p class="fc-hint">
				Currently: <strong><?= htmlspecialchars($viewLabel, ENT_QUOTES) ?></strong>.
				The same control as the pin above the sidebar.
			</p>
			<button class="btn btn-important" type="submit" title="<?= htmlspecialchars($nextViewTitle, ENT_QUOTES) ?>">
				<?= htmlspecialchars($nextViewLabel, ENT_QUOTES) ?>
			</button>
		</div>
	</form>

	<?php
	$mode = $store->mode();
	$demote = $store->demote();
	?>
	<div class="fc-group-label">Mode</div>
	<form method="post" action="<?= $url ?>" id="fc-mode-form">
		<input type="hidden" name="_csrf" value="<?= $csrf ?>" />
		<input type="hidden" name="act" value="mode" />
		<div class="fc-card">
			<label class="fc-mode-opt" title="Nothing is written to your feeds. Filtered in the browser; the API and clients without JavaScript still see everything.">
				<input type="radio" name="mode" value="light" <?= $mode === 'light' ? 'checked' : '' ?> />
				<strong>Light</strong> <span class="fc-hint">&mdash; visual only, writes nothing</span>
			</label>
			<label class="fc-mode-opt" title="Feeds are given FreshRSS's own visibility settings: pinned categories are promoted, everything else pushed down. The previous value of every feed is saved and restored when you switch back or unpin.">
				<input type="radio" name="mode" value="strict" <?= $mode === 'strict' ? 'checked' : '' ?> />
				<strong>Strict</strong> <span class="fc-hint">&mdash; filters for every client, your phone included</span>
			</label>
			<div class="fc-save-bar">
				<button class="btn btn-important" type="submit">Save mode</button>
				<span class="fc-dirty" aria-live="polite"></span>
			</div>
		</div>
	</form>

	<?php if ($mode === 'strict') { ?>
	<div class="fc-group-label">Strict: where unpinned categories go</div>
	<form method="post" action="<?= $url ?>">
		<input type="hidden" name="_csrf" value="<?= $csrf ?>" />
		<input type="hidden" name="act" value="demote" />
		<div class="fc-card">
			<label class="fc-mode-opt" title="Unpinned categories drop out of the main stream on every client, but stay readable in their own category and in reader apps. This uses FreshRSS's 'Show in its feed' (-5).">
				<input type="radio" name="demote" value="stream" <?= $demote === 'stream' ? 'checked' : '' ?> />
				<strong>Out of the main stream</strong>
				<span class="fc-hint">&mdash; still readable in their category</span>
			</label>
			<label class="fc-mode-opt" title="Unpinned categories are removed everywhere, exactly like Hidden Categories' Strict mode. This uses 'Do not show' (-10), so they are not returned to any client at all, including reader apps.">
				<input type="radio" name="demote" value="gone" <?= $demote === 'gone' ? 'checked' : '' ?> />
				<strong>Gone entirely</strong>
				<span class="fc-hint">&mdash; not anywhere, same as Hidden's Strict</span>
			</label>
			<div class="fc-save-bar">
				<button class="btn btn-important" type="submit">Save</button>
				<span class="fc-hint">Feeds enforced: <?= $store->snapshotCount() ?></span>
			</div>
		</div>
	</form>
	<?php } ?>

	<div class="fc-group-label">Sidebar</div>
	<?php
	$rowLabel = $store->rowLabel();
	$modeRow = $store->rowMode();
	$favN = count($favRows);
	?>
	<div class="fc-card">
		<p class="fc-hint">
			How the pinned row in the sidebar tree labels itself. Display only — nothing about
			which categories are pinned, or what the pin button does.
		</p>

		<?php // the saved state, drawn as the real row: this is the confirmation that a change landed ?>
		<div class="fc-preview">
			<span class="fc-preview-cap">Now reads</span>
			<span class="fc-preview-row">
				<span class="fc-caret" aria-hidden="true">&#9662;</span>
				<?php if ($modeRow === 'caret') { ?>
					<span class="fc-preview-none">just the caret &nbsp;&mdash; nothing else</span>
				<?php } elseif ($modeRow === 'both' && $rowLabel !== '') { ?>
					<span class="fc-row-label"><?= htmlspecialchars($rowLabel, ENT_QUOTES) ?></span>
					<span class="fc-row-num"><?= $favN ?></span>
				<?php } else { ?>
					<span class="fc-row-num"><?= $favN ?></span>
				<?php } ?>
			</span>
		</div>

		<?php
		// One form, one Save button, three display states. A checkbox cannot
		// express "label but no number", which is the state that actually
		// obscures the row. A radio group says exactly which of the three it is.
		$modes = [
			'caret' => ['Nothing but the caret', 'the row draws no text at all'],
			'number' => ['The number only', 'how many categories are pinned'],
			'both' => ['Label and number', 'the label, then the number'],
		];
		?>
		<form method="post" action="<?= $url ?>" id="favorite-categories-display-form">
			<input type="hidden" name="_csrf" value="<?= $csrf ?>" />
			<input type="hidden" name="act" value="display" />

			<div class="fc-modes" role="radiogroup" aria-label="What the sidebar row shows">
				<?php foreach ($modes as $val => [$title, $sub]) { ?>
					<label class="fc-mode-radio">
						<input type="radio" name="rowmode" value="<?= $val ?>"
							<?= $modeRow === $val ? 'checked' : '' ?> data-fc-rowmode />
						<span>
							<strong><?= $title ?></strong>
							<em><?= $sub ?></em>
						</span>
					</label>
				<?php } ?>
			</div>

			<label class="fc-label-field">
				<span>Filtered categories</span>
				<select name="filterstyle" class="fc-label-input" data-fc-filterstyle>
					<option value="hide" <?= $store->filterStyle() === 'hide' ? 'selected' : '' ?>>Hidden &mdash; removed from the list</option>
					<option value="dim" <?= $store->filterStyle() === 'dim' ? 'selected' : '' ?>>Dimmed &mdash; kept, but faded</option>
				</select>
			</label>

			<label class="fc-label-field">
				<span>Label text (used by "Label and number")</span>
				<input type="text" name="label" class="fc-label-input"
					value="<?= htmlspecialchars($rowLabel, ENT_QUOTES) ?>"
					placeholder="leave empty for the number on its own"
					maxlength="40" autocomplete="off" data-fc-label />
			</label>

			<?php
			// What the pin button itself draws. A select rather than a pair of
			// switches, because "both" and "neither" are not independent choices:
			// exactly one of symbol/text, or both — never neither.
			$btnContent = $store->buttonContent();
			?>
			<label class="fc-label-field fc-button-field">
				<span>Pin button shows</span>
				<select name="button" class="fc-label-input" data-fc-button>
					<option value="both" <?= $btnContent === 'both' ? 'selected' : '' ?>>Symbol and text</option>
					<option value="icon" <?= $btnContent === 'icon' ? 'selected' : '' ?>>Symbol only</option>
					<option value="text" <?= $btnContent === 'text' ? 'selected' : '' ?>>Text only</option>
				</select>
			</label>

			<div class="fc-save-bar">
				<button class="btn btn-important" type="submit">Save</button>
				<span class="fc-dirty" data-fc-dirty aria-live="polite"></span>
			</div>
		</form>

		<div class="fc-live" aria-live="polite">
			<span class="fc-live-cap">After saving</span>
			<span class="fc-preview-row" data-fc-live>
				<span class="fc-caret" aria-hidden="true">&#9662;</span>
				<?php if ($modeRow === 'both' && $rowLabel !== '') { ?>
					<span class="fc-row-label"><?= htmlspecialchars($rowLabel, ENT_QUOTES) ?></span>
					<span class="fc-row-num"><?= $favN ?></span>
				<?php } elseif ($modeRow !== 'caret') { ?>
					<span class="fc-row-num"><?= $favN ?></span>
				<?php } ?>
			</span>
			<span class="fc-live-msg" data-fc-live-msg>unchanged</span>
		</div>
	</div>

	<details class="fc-details">
		<summary>Details</summary>
		<dl>
			<dt>Pinned</dt><dd><?= count($favRows) ?> of <?= count($cats) ?> categories</dd>
			<dt>View</dt><dd><?= htmlspecialchars($viewLabel, ENT_QUOTES) ?></dd>
			<dt>Written to feeds</dt><dd><?= $mode === 'strict'
				? 'Strict: one column (visibility) on every feed, previous values saved in feed_snap and restored when you switch back, unpin, or disable. Feeds in categories hidden by another extension are never touched.'
				: 'Nothing. Light filters in the browser only.' ?></dd>
			<dt>On since</dt><dd><?= htmlspecialchars($store->getMeta('first_enabled_at', '—'), ENT_QUOTES) ?></dd>
			<dt>Last disabled</dt><dd><?= htmlspecialchars($store->getMeta('last_disabled_at', 'never'), ENT_QUOTES) ?></dd>
			<dt>Storage</dt><dd><code><?= htmlspecialchars($store->path(), ENT_QUOTES) ?></code></dd>
			<dt>Works with</dt><dd>Any extension: this one only ever reads the page's own markup, and
				never takes over a row another extension has hidden.</dd>
			<dt>Switching off</dt><dd>Strict restores every feed it changed, then disables. If the
				restore cannot finish, the disable is refused and the extension stays enabled so it
				can be fixed from here. Pins and display options are kept either way.</dd>
		</dl>
	</details>
</div>
